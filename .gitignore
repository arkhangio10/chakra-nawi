# Entornos y dependencias
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.pnpm-store/

# Builds
dist/
build/
.vite/
coverage/

# Datos descargados (CHIRPS, NASA POWER, datasets)
data/raw/
data/descargas/
*.tif
*.tiff
*.nc

# Modelos pesados y entrenamiento
ml/datasets/
ml/runs/
ml/weights/
*.pt
*.onnx
*.engine
*.tflite

# Fotos de casos y base local de la API
api/uploads/
*.sqlite
*.sqlite3
*.db

# Secretos
.env
.env.*
!.env.example

# Sistema y editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Datos privados de la API (teléfonos de las productoras, Ley 29733)
api/fincas_privadas.json
api/data/

# PWA: el runtime de onnxruntime-web se copia en cada build (14 MB)
apps/campo/public/ort/
# El modelo que usa la PWA sí se versiona (es pequeño y la app no funciona sin él)
!apps/campo/public/models/*.onnx
