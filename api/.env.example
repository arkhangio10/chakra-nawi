# Copiar a api/.env (no se sube a git). Sin credenciales de Twilio, las llamadas quedan "simuladas".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
# URL pública de esta API: Twilio descarga los .mp3 desde aquí. En local sin túnel da igual (llamada simulada).
# Con túnel: la URL https://….trycloudflare.com. En Render no hace falta (usa RENDER_EXTERNAL_URL).
PUBLIC_BASE_URL=http://localhost:8000

# Teléfonos de las productoras (Ley 29733): o el archivo api/fincas_privadas.json (ver .example),
# o el JSON entero en esta variable (así se pasa como secreto en Render):
# CHAKRA_FINCAS_PRIVADAS_JSON={"LC-001": {"telefono": "+519XXXXXXXX", "idioma": "quz"}}

# Opcionales (valores por defecto en local; el Dockerfile los pone en /data, no los copies al contenedor)
# CHAKRA_DB=api/data/chakra.sqlite
# CHAKRA_FOTOS=api/uploads
# CHAKRA_FINCAS_PRIVADAS=api/fincas_privadas.json
# CHAKRA_AUDIO=audio
# CHAKRA_REGLAS=packages/motor/rules.json   (por defecto: ese archivo si existe; si no, contracts/rules.example.json)
