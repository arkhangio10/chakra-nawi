# Copiar a api/.env (no se sube a git). Sin credenciales de Twilio, las llamadas quedan "simuladas".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
# URL pública de esta API (Twilio descarga los .mp3 desde aquí)
PUBLIC_BASE_URL=https://chakra-nawi-api.example.com
# Opcionales
CHAKRA_DB=api/data/chakra.sqlite
CHAKRA_FOTOS=api/uploads
CHAKRA_FINCAS_PRIVADAS=api/fincas_privadas.json
